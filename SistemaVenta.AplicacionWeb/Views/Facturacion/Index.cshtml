@{
    ViewData["Title"] = "Facturacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos{
    <!-- ============================================================
    =ESTILOS PARA ESTA PAGINA
    ===============================================================-->
    <link href="~/vendor/select2/select2.min.css" rel="stylesheet">

    <style>
        .select2 {
            width: 100% !important;
        }
    </style>
}

<div class="row">
    <h1>Facturación</h1>
    <div class="col-12 m-3">
        
            <input type="hidden" value="0" id="txtId" />
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-row">
                        <div class="form-group col-sm-4">
                            <label for="cboSerie">Serie:</label>
                            <select class="form-control form-control-sm"
                                    id="cboSerie">
                                <option value="" disabled selected>Seleccionar una opcioón</option>
                                <option value="A">Serie A</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="cboFormaDePago">Forma de Pago:</label>
                            <select class="form-control form-control-sm"
                                    id="cboFormaDePago">
                            <option value="" disabled selected>Seleccionar una opcioón</option>
                                <option value="01">Efectivo</option>
                                <option value="04">Tarjeta de crédito</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="txtStock">Moneda:</label>
                            <input type="text"
                                   class="form-control form-control-sm input-validar"
                                   id="txtStock"
                                   name="Stock"
                                   value="MXN"
                                   readonly />
                        </div>
                    </div>
                </div>
            </div>
            <!-- Parte 2 -->
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-row">
                        <div class="form-group col-sm-4">
                            <label for="cboTipoComprobante">Tipo de Comprobante:</label>
                            <select class="form-control form-control-sm"
                                    id="cboTipoComprobante">
                                <option value="" disabled selected>Seleccionar una opcioón</option>
                                <option value="I">Ingreso</option>
                                <option value="E">Egreso</option>
                                <option value="T">Translado</option>
                                <option value="P">Pago</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="cboMetodoPago">Metodo de pago:</label>
                            <select class="form-control form-control-sm"
                                    id="cboMetodoPago">
                                <option value="" disabled selected>Seleccionar una opcioón</option>
                                <option value="PUE">
                                    Pago en una sola exhibición
                                </option>
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="tipoCambio">Tipo de cambio:</label>
                            <input type="text"
                                   class="form-control form-control-sm input-validar"
                                   id="tipoCambio"
                               name="tipoCambio"
                                   value="1.0"
                                   readonly />
                        </div>
                    </div>
                </div>
            </div>
            <!-- Parte 3 -->
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-row">
                        <div class="form-group col-sm-8">
                            <label for="usoCFDI">Uso CFDI:</label>
                            <select class="form-control form-control-sm"
                                    id="usoCFDI">
                                <option value="" disabled selected>Seleccionar una opcioón</option>
                                <option value="G01">
                                    Adquisición de mercancías.
                                </option>
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="regimenFiscal">Regimen Fiscal:</label>
                            <input type="text"
                                   class="form-control form-control-sm input-validar"
                                   id="regimenFiscal"
                                   name="Stock"
                               value="regimenFiscal"
                                   readonly />
                        </div>
                    </div>
                </div>
            </div>
            <h2>Cliente</h2>
            <div class="col-sm-5">
                <div class="form-row">
                    <div class="form-group col-sm-12">
                        <select class="form-control form-control-sm" id="cboBuscarCliente">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
              </div>
                <!-- DATOS CLIENTE -->
                <div class="row">
                    <div class="col-sm-10">
                        <div class="form-row">
                            <div class="form-group col-sm-4">
                            <label for="nombreRazonSocial">Nombre o razón social:</label>
                                <input type="text"
                                       class="form-control form-control-sm input-validar"
                                       id="nombreRazonSocial"
                                       name="Stock"
                                       value=""
                                       readonly />
                            </div>
                            <div class="form-group col-sm-4">
                                <label for="txtRFC">RFC:</label>
                                <input type="text"
                                       class="form-control form-control-sm input-validar"
                                       id="txtRFC"
                                       name="Stock"
                                       value=""
                                       readonly />
                            </div>
                            <div class="form-group col-sm-4">
                                <label for="txtCorreo">Correo:</label>
                                <input type="text"
                                       class="form-control form-control-sm input-validar"
                                       id="txtCorreo"
                                       name="Stock"
                                       value=""
                                       readonly />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-10">
                        <div class="form-row">
                            <div class="form-group col-sm-4">
                                <label for="txtCP">Domicilio Fiscal(C.P.):</label>
                                <input type="text"
                                       class="form-control form-control-sm input-validar"
                                       id="txtCP"
                                       name="Stock"
                                       value=""
                                       readonly />
                            </div>
                            <div class="form-group col-sm-4">
                                <label for="txtRegimenFiscal">Regimen Fiscal:</label>
                                <input type="text"
                                       class="form-control form-control-sm input-validar"
                                   id="txtRegimenFiscal"
                                       name="Stock"
                                       value=""
                                       readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </>
            <!-- DATOS VENTA -->
            <h2>Venta</h2>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-row align-items-end">
                        <div class="form-group col-sm-3 busqueda-venta">
                            <label for="txtNumeroVenta">Numero Venta</label>
                            <input type="text"
                                   class="form-control form-control-sm"
                                   id="txtNumeroVenta" />
                        </div>
                        <div class="form-group col-sm-3">
                            <button class="btn btn-success btn-block btn-sm"
                                    type="button"
                                    id="btnBuscar">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-4">
                            <label for="numVentaInput">Numero Venta</label>
                            <input type="text" class="form-control form-control-sm" id="numVentaInput" disabled>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="txtFechaRegistro">Fecha Registro</label>
                            <input type="text" class="form-control form-control-sm" id="txtFechaRegistro" disabled>
                        </div>
                        
                        <div class="form-group col-sm-4">
                            <label for="txtUsuarioRegistro">Usuario Registro</label>
                            <input type="text" class="form-control form-control-sm" id="txtUsuarioRegistro" disabled>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-sm-12">
                            <table id="tbProductos" class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @* TOTALES *@
            <div class="row">
                <div class="col-sm-4">
                    <div class="input-group input-group-sm mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="inputGroupDescuento">Descuento</span>
                        </div>
                        <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupDescuento" id="txtDescuento" disabled>
                    </div>
                    <div class="input-group input-group-sm mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="inputGroupSubTotal">Sub Total</span>
                        </div>
                        <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupSubTotal" id="txtSubTotal" disabled>
                    </div>
                    <div class="input-group input-group-sm mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="inputGroupIGV">IVA(18%)</span>
                        </div>
                        <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupIGV" id="txtIGV" disabled>
                    </div>
                    <div class="input-group input-group-sm mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="inputGroupTotal">Total</span>
                        </div>
                        <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupTotal" id="txtTotal" disabled>
                    </div>
                </div>
            </div>
            <button id="btnTimbrar" class="btn btn-primary">TIMBRAR</button>
        
    </div>
</div>



@section Scripts{
    <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/jquery-ui/jquery-ui.js"></script>
    <script src="~/vendor/jquery-ui/idioma/datepicker-es.js"></script>

    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>

    <script src="~/vendor/select2/select2.min.js"></script>
    <script src="~/vendor/select2/es.min.js"></script>

    <script src="~/js/vistas/Facturacion.js"></script>

}